terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~>3.0"
    }
    azapi = {
      source  = "azure/azapi"
      version = "~> 2.6.0"
    }
    azuread = {
      source  = "hashicorp/azuread"
      version = "~> 2.23.0"
    }
    azuredevops = {
      source  = "microsoft/azuredevops"
      version = ">=1.0"
    }
  }

  required_version = ">= 1.4.0"
}

provider "azurerm" {
  features {}
}

provider "azurerm" {
  features {
    key_vault {
      purge_soft_delete_on_destroy    = false
      recover_soft_deleted_key_vaults = true
    }
  }
 
  alias                      = "production"
  use_oidc                   = true
  tenant_id                  = "e60ce638-7fe6-4656-80a3-2fd85e9c2525"
  subscription_id            = "ee3f4544-7b5f-44f7-af75-2a4ca66cfeec"
  client_id                  = "6864b145-bc2a-4625-8f67-36bb75ccffa2"
  skip_provider_registration = true
}


provider "azapi" {
  use_oidc                   = true
  tenant_id                  = "e60ce638-7fe6-4656-80a3-2fd85e9c2525"
  subscription_id            = "ee3f4544-7b5f-44f7-af75-2a4ca66cfeec"
  client_id                  = "6864b145-bc2a-4625-8f67-36bb75ccffa2"
  skip_provider_registration = true
}

# Configure the Microsoft Azure Provider
provider "azuread" {
  use_oidc = true # or use the environment variable "ARM_USE_OIDC=true"
  // features {}
}


provider "azuredevops" {
  use_oidc = true
}